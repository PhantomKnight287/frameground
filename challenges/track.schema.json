{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the track"
    },
    "description": {
      "type": "string",
      "description": "Description of the track"
    },
    "logo": {
      "type": "string",
      "description": "Logo of the track: a path served from the app's public dir (e.g. /tracks/react.svg, added with scripts/add-track-logo.mjs) or an absolute URL"
    },
    "status": {
      "type": "string",
      "description": "Status of the track",
      "enum": [
        "active",
        "coming_soon"
      ]
    }
  },
  "required": [
    "name",
    "description",
    "logo",
    "status"
  ]
}
